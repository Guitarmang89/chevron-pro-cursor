    # ---- state
    def set_color(self, key, hx, redraw=True):
        if hx is not None:
            hx = hx if hx.startswith("#") else "#" + hx
            try:
                core.hex_rgb(hx)
            except ValueError:
                self.status.set_label(f"Not a valid color: {hx}"); return
            hx = hx.upper()
        if key == "color" and hx is None:
            return
        self.s[key] = hx
        sw, cb, ent, auto = self.rows[key]
        o = core.opts_of(self.s)
        shown = hx or "#%02X%02X%02X" % (core.glow_rgb(o) if key == "glow_color" else core.outline_rgb(o))
        ent.set_text(hx or "")
        ent.set_placeholder_text(("match" if key == "glow_color" else "auto") if hx is None else "")
        if rgba_to_hex(cb.get_rgba()) != shown:
            self._syncing = True
            rgba = Gdk.RGBA(); rgba.parse(shown); cb.set_rgba(rgba)
            self._syncing = False
        for h, b in sw.items():
            (b.add_css_class if h.upper() == hx else b.remove_css_class)("selected")
        if auto:
            (auto.add_css_class if hx is None else auto.remove_css_class)("selected")
        if key == "color":   # "Auto"/"Match line" rows follow the main color
            for k in ("outline_color", "glow_color"):
                if self.s.get(k) is None and k in self.rows:
                    self.set_color(k, None, redraw=False)
        if hasattr(self, "trail_cb") and not self.s.get("trail_color_custom"):
            self._sync_trail_color()
        if hasattr(self, "hb_cb") and not self.s.get("heartbeat_color_custom"):
            self._sync_hb_color()
        if redraw:
            self._mark_custom()
            self.redraw()

    def _from_dialog(self, key, btn):
        if getattr(self, "_syncing", False):
            return
        hx = rgba_to_hex(btn.get_rgba())
        if hx != self.s.get(key):
            self.set_color(key, hx)

    # ---- presets
    CUSTOM = "Custom (your current settings)"

    def reload_presets(self, select=None):
        self._loading = True
        self._presets = core.all_presets()
        labels = [self.CUSTOM] + [n if b else f"{n}  (saved)" for n, _v, b in self._presets]
        self.preset_model.splice(0, self.preset_model.get_n_items(), labels)
        idx = next((i + 1 for i, (n, _v, _b) in enumerate(self._presets) if n == select), 0)
        self.preset_dd.set_selected(idx)
        self._loading = False
        self._sync_preset_buttons()

    def current_preset(self):
        i = self.preset_dd.get_selected()
        return self._presets[i - 1][0] if 0 < i <= len(self._presets) else None

    def _sync_preset_buttons(self):
        i = self.preset_dd.get_selected()
        user = 0 < i <= len(self._presets) and not self._presets[i - 1][2]
        self.ren_btn.set_sensitive(user)
        self.del_btn.set_sensitive(user)

    def on_preset_selected(self, dd, _p):
        self._sync_preset_buttons()
        if self._loading:
            return
        name = self.current_preset()
        if name:
            self.load_preset(self._presets[dd.get_selected() - 1][1])
            self.s["preset"] = name
            self.status.set_label(f"Loaded preset '{name}'. Click Apply to use it.")

    def _mark_custom(self):
        if getattr(self, "_loading", False) or not hasattr(self, "preset_dd"):
            return
        self.s.pop("preset", None)
        if self.preset_dd.get_selected() != 0:
            self._loading = True
            self.preset_dd.set_selected(0)
            self._loading = False
            self._sync_preset_buttons()

    def load_preset(self, preset):
        self._loading = True
        try:
            for k, v in preset.items():
                if k in ("color", "outline_color", "glow_color"):
                    self.set_color(k, v, redraw=False)
                elif k in self.sliders:
                    self.s[k] = v
                    self.sliders[k].set_value(v)
                elif k == "heartbeat":
                    self.s[k] = bool(v)
                    self.hb_check.set_active(bool(v))
                elif k == "size":
                    self.s[k] = int(v)
                    if int(v) in SIZE_CHOICES:
                        self.size_dd.set_selected(SIZE_CHOICES.index(int(v)))
            # presets remember the trail color choice (built-ins: follow the cursor); applied live
            self.s["trail_color_custom"] = bool(preset.get("trail_color_custom", False))
            if preset.get("trail_color"):
                self.s["trail_color"] = preset["trail_color"]
            self._sync_trail_color()
            self.s["heartbeat_color_custom"] = bool(preset.get("heartbeat_color_custom", False))
            if preset.get("heartbeat_color"):
                self.s["heartbeat_color"] = preset["heartbeat_color"]
            self._sync_hb_color()
        finally:
            self._loading = False
        core.save_trail_settings({k: self.s.get(k) for k in core.TRAIL_KEYS})
        self.redraw()

    def name_dialog(self, title, initial, on_ok):
        dlg = Gtk.Window(title=title, transient_for=self, modal=True, resizable=False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_top=14, margin_bottom=14, margin_start=14, margin_end=14)
        box.append(Gtk.Label(label="Preset name:", xalign=0))
        ent = Gtk.Entry(text=initial or "", activates_default=True, width_chars=28)
        box.append(ent)
        err = Gtk.Label(xalign=0); err.add_css_class("error"); box.append(err)
        btns = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Cancel"); ok = Gtk.Button(label="Save"); ok.add_css_class("suggested-action")
        btns.append(cancel); btns.append(ok); box.append(btns)
        dlg.set_child(box); dlg.set_default_widget(ok)

        def go(*_a):
            try:
                on_ok(ent.get_text())
                dlg.destroy()
            except ValueError as e:
                err.set_label(str(e))
        ok.connect("clicked", go); ent.connect("activate", go)
        cancel.connect("clicked", lambda _b: dlg.destroy())
        dlg.present()
        self._dialog = dlg  # for tests

    def do_save(self, name):
        name = core.save_preset(name, self.s)
        self.s["preset"] = name
        self.reload_presets(select=name)
        self.status.set_label(f"Saved preset '{name}'.")

    def do_rename(self, new):
        old = self.current_preset()
        new = core.rename_preset(old, new)
        self.s["preset"] = new
        self.reload_presets(select=new)
        self.status.set_label(f"Renamed '{old}' to '{new}'.")

    def do_delete(self, _b):
        name = self.current_preset()
        try:
            core.delete_preset(name)
        except ValueError as e:
            self.status.set_label(str(e)); return
        self.s.pop("preset", None)
        self.reload_presets()
        self.status.set_label(f"Deleted preset '{name}'. Your current settings are unchanged.")

    # ---- slider value: label, double-click to type
    def _value_box(self, sc, lo, hi, fmt, mult=1):
        stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.NONE, hhomogeneous=False, vhomogeneous=True)
        lab = Gtk.Label(xalign=0, width_chars=12, max_width_chars=12, tooltip_text="Double-click to type a value")
        lab.add_css_class("numeric")
        spin = Gtk.SpinButton.new_with_range(lo * mult, hi * mult, 1)
        spin.set_digits(0); spin.set_numeric(True); spin.set_width_chars(5); spin.set_halign(Gtk.Align.START)
        stack.add_named(lab, "label"); stack.add_named(spin, "edit")
        state = {"editing": False}

        def show(_w=None):
            lab.set_label(fmt(sc.get_value()))
            if not state["editing"]:
                spin.set_value(round(sc.get_value() * mult))
        sc.connect("value-changed", show)
        show()

        def start(_g, n, _x, _y):
            if n == 2:
                state["editing"] = True
                spin.set_value(round(sc.get_value() * mult))
                stack.set_visible_child_name("edit")
                spin.grab_focus()
        click = Gtk.GestureClick(); click.connect("pressed", start); lab.add_controller(click)

        def commit(*_a):
            if not state["editing"]:
                return
            state["editing"] = False
            spin.update()                            # parse what was typed
            v = max(lo * mult, min(hi * mult, spin.get_value()))
            sc.set_value(round(v / mult))            # clamps to the slider range and syncs everything
            stack.set_visible_child_name("label")
            show()
        spin.connect("activate", commit)
        foc = Gtk.EventControllerFocus(); foc.connect("leave", commit); spin.add_controller(foc)
        keys = Gtk.EventControllerKey()

        def esc(_c, keyval, _code, _mods):
            if keyval == Gdk.KEY_Escape:
                state["editing"] = False; stack.set_visible_child_name("label"); show(); return True
            return False
        keys.connect("key-pressed", esc); spin.add_controller(keys)
        stack._commit = commit; stack._start = lambda: start(None, 2, 0, 0); stack._spin = spin; stack._label = lab
        sc._valuebox = stack                         # for tests
        return stack

    # ---- heartbeat color
    def _sync_hb_color(self):
        custom = bool(self.s.get("heartbeat_color_custom"))
        if self.hb_custom_sw.get_active() != custom:
            self._syncing = True; self.hb_custom_sw.set_active(custom); self._syncing = False
        glow = "#%02X%02X%02X" % core.glow_rgb(core.opts_of(self.s))
        shown = (self.s.get("heartbeat_color") or glow) if custom else glow
        if rgba_to_hex(self.hb_cb.get_rgba()) != shown.upper():
            self._syncing = True
            rgba = Gdk.RGBA(); rgba.parse(shown); self.hb_cb.set_rgba(rgba)
            self._syncing = False
        self.hb_cb.set_sensitive(custom); self.hb_reset.set_sensitive(custom)

    def on_hb_custom(self, sw, _p):
        if getattr(self, "_syncing", False):
            return
        self.s["heartbeat_color_custom"] = sw.get_active()
        if sw.get_active() and not self.s.get("heartbeat_color"):
            self.s["heartbeat_color"] = "#%02X%02X%02X" % core.glow_rgb(core.opts_of(self.s))
        self._sync_hb_color(); self._mark_custom(); self.redraw()

    def on_hb_rgba(self, btn, _p):
        if getattr(self, "_syncing", False) or not self.s.get("heartbeat_color_custom"):
            return
        self.s["heartbeat_color"] = rgba_to_hex(btn.get_rgba())
        self._mark_custom(); self.redraw()

    def on_hb_reset(self, _b):
        self.s["heartbeat_color_custom"] = False; self.s["heartbeat_color"] = None
        self._sync_hb_color(); self._mark_custom(); self.redraw()

    # ---- window size
    def _half_size(self):
        try:
            mons = Gdk.Display.get_default().get_monitors()
            g = mons.get_item(0).get_geometry()
            return max(560, int(g.width * core.WIN_W_FRAC)), max(420, int(g.height * core.WIN_H_FRAC))
        except Exception:
            return 760, 560

    def toggle_expand(self):
        if not self._expanded:
            self.fullscreen()
            self.expand_btn.set_icon_name("view-restore-symbolic")
            self.expand_btn.set_tooltip_text("Back to the normal window (F11)")
        else:
            self.unfullscreen(); self.unmaximize()
            self.set_default_size(*self._half_size())
            self.expand_btn.set_icon_name("view-fullscreen-symbolic")
            self.expand_btn.set_tooltip_text("Expand to full screen (F11)")
        self._expanded = not self._expanded

    # ---- trail color
    def _cursor_trail_hex(self):
        return "#%02X%02X%02X" % core.glow_rgb(core.opts_of(self.s))

    def _sync_trail_color(self):
        custom = bool(self.s.get("trail_color_custom"))
        if self.trail_custom_sw.get_active() != custom:
            self._syncing = True; self.trail_custom_sw.set_active(custom); self._syncing = False
        shown = (self.s.get("trail_color") or self._cursor_trail_hex()) if custom else self._cursor_trail_hex()
        if rgba_to_hex(self.trail_cb.get_rgba()) != shown.upper():
            self._syncing = True
            rgba = Gdk.RGBA(); rgba.parse(shown); self.trail_cb.set_rgba(rgba)
            self._syncing = False
        self.trail_cb.set_sensitive(custom)
        self.trail_reset.set_sensitive(custom)

    def _save_trail_color(self):
        core.save_trail_settings({"trail_color_custom": bool(self.s.get("trail_color_custom")),
                                  "trail_color": self.s.get("trail_color")})

    def on_trail_custom(self, sw, _p):
        if getattr(self, "_syncing", False):
            return
        self.s["trail_color_custom"] = sw.get_active()
        if sw.get_active() and not self.s.get("trail_color"):
            self.s["trail_color"] = self._cursor_trail_hex()
        self._sync_trail_color(); self._save_trail_color()
        self.status.set_label("Trail: custom color." if sw.get_active() else "Trail: follows the cursor's own colors.")

    def on_trail_rgba(self, btn, _p):
        if getattr(self, "_syncing", False) or not self.s.get("trail_color_custom"):
            return
        self.s["trail_color"] = rgba_to_hex(btn.get_rgba())
        self._save_trail_color()

    def on_trail_reset(self, _b):
        self.s["trail_color_custom"] = False
        self.s["trail_color"] = None
        self._sync_trail_color(); self._save_trail_color()
        self.status.set_label("Trail: follows the cursor's own colors.")

    # ---- trail
    def trail_changed(self, key, value):
        self.s[key] = value
        if self._trail_pending:
            GLib.source_remove(self._trail_pending)
        def save():
            self._trail_pending = None
            # only trail_* keys are written (the daemon reloads them live)
            core.save_trail_settings({k: self.s.get(k) for k in core.TRAIL_KEYS})
            return False
        self._trail_pending = GLib.timeout_add(150, save)

    def on_trail_toggle(self, sw, _p):
        on = sw.get_active()
        self.s["trail_enabled"] = on
        core.save_trail_settings({k: self.s.get(k) for k in core.TRAIL_KEYS})
        core.set_trail_autostart(on)
        if on:
            core.start_trail()
            self.status.set_label("Cursor trail on (starts automatically at login).")
        else:
            core.stop_trail()
            self.status.set_label("Cursor trail off.")

    def update(self, key, value):
        self.s[key] = value
        self._mark_custom()
        self.redraw()

    def redraw(self):
        # debounce slider drags
        if self._pending:
            GLib.source_remove(self._pending)
        self._pending = GLib.timeout_add(60, self._do_redraw)

    def _do_redraw(self):
        self._pending = None
        self.preview.set_settings(self.s)
        return False

    # ---- actions
    def _bg(self, fn, done_msg):
        self.apply_btn.set_sensitive(False)
        self.status.set_label("Working…")

        def work():
            try:
                log = fn()
                msg = done_msg + "\n" + "\n".join(log)
            except Exception as e:  # show any failure in the window
                msg = f"Failed: {e}"
            GLib.idle_add(self._finish, msg)
        threading.Thread(target=work, daemon=True).start()

    def _finish(self, msg):
        self.status.set_label(msg)
        self.apply_btn.set_sensitive(True)
        return False

    def on_apply(self, _b):
        saved = core.load_settings()
        if "previous" in saved:          # keep the cursor we restore on Reset
            self.s["previous"] = saved["previous"]
        self._bg(lambda: core.apply(self.s), "Applied. Log out/in once so every app picks it up.")

    def on_reset(self, _b):
        self._bg(lambda: core.reset(core.load_settings()), "Reset to your previous cursor.")


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        win = self.props.active_window or Window(self)
        win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
